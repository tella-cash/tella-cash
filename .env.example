# Copy to .env and fill in. Everything here is required unless marked
# optional.

# --- App ---------------------------------------------------------------
# Public origin the app is served from. It is the WebAuthn relying-party ID,
# so pin it to the final production domain before real users register
# passkeys: credentials do not survive a domain change.
APP_BASE_URL=https://www.tella.cash

# --- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Circle ------------------------------------------------------------
# Mainnet needs a mainnet API key, entity secret and wallet set: testnet ones
# don't carry over, and neither do wallets created on testnet.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# ARC-TESTNET or ARC (mainnet). Anything else fails loudly. The faucet is
# switched off on ARC.
ARC_NETWORK=ARC
# Pins which token id a transfer spends from. Optional, and a useful belt to
# the braces: the code already refuses any "USDC" whose contract is not Arc's
# predeploy, and this pins the choice to one token id on top of that. It fails
# closed — a pin naming a token the wallets do not hold refuses every send
# rather than falling back. Token ids differ per network, so clear it when
# switching.
CIRCLE_USDC_TOKEN_ID=
# Optional. Explorer base for transaction links. Defaults to
# https://explorer.arc.io/tx on ARC and https://testnet.arcscan.app/tx on
# ARC-TESTNET. Check it against a real transaction.
ARC_EXPLORER_TX_URL=

# --- WhatsApp (Meta Cloud API) -----------------------------------------
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
# Number users message, used for the "back to chat" deep link.
META_WHATSAPP_DISPLAY_NUMBER=

# --- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bare username, no leading @. Builds the account-link deep link.
TELEGRAM_BOT_USERNAME=
# Same value, for the landing page's "Chat on Telegram" button. Inlined at
# build time, so redeploy after changing it.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- sendam-ai ---------------------------------------------------------
SENDAM_AI_BASE_URL=
SENDAM_AI_SIGNING_SECRET=

# --- Google sign-in ----------------------------------------------------
# Web freeze, unfreeze, linking a Google account for security email, and
# admin sign-in. Register this redirect URI in Google Cloud:
#   <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the OAuth state. Use a long random value.
GOOGLE_STATE_SECRET=

# --- Admin dashboard ---------------------------------------------------
# Google subject ids allowed into /admin, comma-separated. Empty means
# nobody. To find a sub, sign in once and read the rejection line in the logs.
ADMIN_GOOGLE_SUBS=
# Signs the admin session cookie. Must differ from GOOGLE_STATE_SECRET.
ADMIN_SESSION_SECRET=

# --- Cron --------------------------------------------------------------
# Vercel Cron sends it as a bearer token. /api/cron/* refuse to run without it.
CRON_SECRET=

# --- Security email ----------------------------------------------------
# Notices to the user's linked Google address: PIN reset, new channel linked,
# transfer queued, freeze/unfreeze. The only notice a SIM swap doesn't also
# capture. Unset, they only reach the logs. A POST shaped like Resend's API.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Optional: alerts --------------------------------------------------
# Slack/Discord-compatible webhook for security events (forged webhook
# signatures, lockouts, transfers of unknown outcome).
ALERT_WEBHOOK_URL=

# --- Optional: send limits (unset = off) -------------------------------
# Largest single transfer, in USDC.
TELLA_MAX_SEND_USDC=
# Rolling 24-hour per-user total, in USDC.
TELLA_DAILY_SEND_LIMIT_USDC=
# Sends above this wait 24 hours before going out.
TELLA_HOLD_THRESHOLD_USDC=
# Not configurable: for 48 hours after a PIN reset, passkey removal or a new
# Telegram/Google link, every send waits 24 hours.
