# Copy to .env and fill in. Nothing here is optional unless marked so —
# several of these used to have silent fallbacks that produced a working-
# looking app with broken security (see APP_BASE_URL below).

# --- App ---------------------------------------------------------------
# Public origin the app is served from. REQUIRED: it is the source of the
# WebAuthn relying-party ID, and there is deliberately no fallback. When it
# was defaulted to http://localhost:3000, a deployment without it registered
# passkeys against rpID "localhost" — they enrolled fine and then failed to
# authenticate forever, silently.
APP_BASE_URL=https://www.tella.cash

# --- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
# Only needed to run migrations: psql $SUPABASE_DB_URL -f migrations/000N_*.sql
SUPABASE_DB_URL=

# --- Circle ------------------------------------------------------------
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ADDRESS=
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_SET_ID=
ARC_NETWORK=ARC-TESTNET
# Optional. Defaults to https://api.circle.com
CIRCLE_API_BASE=
# Optional. Pins which USDC token a transfer spends from, for when the
# testnet lists more than one USDC-symbol token on a wallet. Left unset,
# the largest USDC balance is used.
CIRCLE_USDC_TOKEN_ID=
# Local dev only. Skips webhook signature verification so you can POST test
# notifications by hand. Ignored outright when NODE_ENV=production.
CIRCLE_WEBHOOK_VERIFY_DISABLED=
# Optional. Explorer base for transaction links; defaults to Arc testnet.
ARC_EXPLORER_TX_URL=

# --- Twilio WhatsApp ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=
TWILIO_MENU_CONTENT_SID=
TWILIO_LIST_CONTENT_SID=

# --- Meta WhatsApp Cloud API -------------------------------------------
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
# Number users message, used for the "back to chat" deep link.
META_WHATSAPP_DISPLAY_NUMBER=

# Local dev only. Lets unsigned WhatsApp webhooks through so you can replay
# payloads with curl. Ignored outright when NODE_ENV=production.
WHATSAPP_ALLOW_UNSIGNED=

# --- sendam-ai ---------------------------------------------------------
SENDAM_AI_BASE_URL=
SENDAM_AI_SIGNING_SECRET=
# Local dev only. Logs full request/response bodies — which contain the
# literal text users type into WhatsApp. Ignored when NODE_ENV=production.
SENDAM_DEBUG=

# --- Send limits (optional, defaults shown) ----------------------------
# Largest single transfer, in USDC.
TELLA_MAX_SEND_USDC=100
# Rolling 24-hour per-user total, in USDC.
TELLA_DAILY_SEND_LIMIT_USDC=500

# --- Cron + alerting ---------------------------------------------------
# REQUIRED for /api/cron/*. Vercel Cron sends it as a bearer token; the same
# value works for a manual curl. The routes refuse to run without it.
CRON_SECRET=

# Optional. Slack/Discord-compatible incoming webhook. Security events
# (forged webhook signatures, PIN lockouts, transfers of unknown outcome)
# POST here. Without it they degrade to structured console.error lines that
# a log drain can alert on.
ALERT_WEBHOOK_URL=

# --- Auth rate limiting (optional, defaults shown) ---------------------
# Attempts permitted per user per scope before lockout.
TELLA_AUTH_MAX_ATTEMPTS=5
TELLA_AUTH_WINDOW_SECONDS=900
TELLA_AUTH_LOCKOUT_SECONDS=900
